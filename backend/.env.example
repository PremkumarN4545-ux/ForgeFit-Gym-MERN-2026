PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/forgefit
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Razorpay test-mode credentials (never expose the secret in frontend variables)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Used only by `npm run seed` to create the initial admin
ADMIN_NAME=ForgeFit Admin
ADMIN_EMAIL=admin@forgefit.local
ADMIN_PASSWORD=replace-with-a-strong-password
